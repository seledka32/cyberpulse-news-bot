meters":{"url":"https://news.google.com/rss/search?q=site%3Adexerto.com%2Fesports%20(CS2%20OR%20Dota%202%20OR%20esports)&hl=en-US&gl=US&ceid=US%3Aen"},"id":"rss-7","name":"RSS 7 — Dexerto Esports","type":"n8n-nodes-base.rssFeedRead","typeVersion":1.2,"position":[-1000,50]},{"parameters":{"url":"https://news.google.com/rss/search?q=site%3Aesports.gg%20(CS2%20OR%20Dota%202%20OR%20esports)&hl=en-US&gl=US&ceid=US%3Aen"},"id":"rss-8","name":"RSS 8 — Esports.gg","type":"n8n-nodes-base.rssFeedRead","typeVersion":1.2,"position":[-1000,150]},{"parameters":{"url":"https://news.google.com/rss/search?q=site%3Aesportsinsider.com%20esports&hl=en-US&gl=US&ceid=US%3Aen"},"id":"rss-9","name":"RSS 9 — Esports Insider","type":"n8n-nodes-base.rssFeedRead","typeVersion":1.2,"position":[-1000,250]},{"parameters":{"url":"https://news.google.com/rss/search?q=site%3Aoneesports.gg%20(CS2%20OR%20Dota%202%20OR%20esports)&hl=en-US&gl=US&ceid=US%3Aen"},"id":"rss-10","name":"RSS 10 — ONE Esports","type":"n8n-nodes-base.rssFeedRead","typeVersion":1.2,"position":[-1000,350]},{"parameters":{"url":"https://news.google.com/rss/search?q=site%3Aestnn.com%20(CS2%20OR%20Dota%202%20OR%20esports)&hl=en-US&gl=US&ceid=US%3Aen"},"id":"rss-11","name":"RSS 11 — ESTNN","type":"n8n-nodes-base.rssFeedRead","typeVersion":1.2,"position":[-1000,450]},{"parameters":{"url":"https://news.google.com/rss/search?q=site%3Atalkesport.com%20(CS2%20OR%20Dota%202%20OR%20esports)&hl=en-US&gl=US&ceid=US%3Aen"},"id":"rss-12","name":"RSS 12 — TalkEsport","type":"n8n-nodes-base.rssFeedRead","typeVersion":1.2,"position":[-1000,550]},{"parameters":{"numberInputs":12},"id":"merge","name":"Merge — все 12 источников","type":"n8n-nodes-base.merge","typeVersion":3.2,"position":[-650,0]},{"parameters":{"jsCode":"const now = Date.now();\nconst maxAge = 48 * 60 * 60 * 1000;\nconst staticData = $getWorkflowStaticData('global');\nstaticData.seen = staticData.seen || {};\n\nfor (const [url, timestamp] of Object.entries(staticData.seen)) {\n  if (now - timestamp > 30 * 24 * 60 * 60 * 1000) delete staticData.seen[url];\n}\n\nconst priorityWords = /\\b(cs2|counter.?strike|dota\\s?2|major|the international|iem|blast|esl|spirit|navi|natus vincere|betboom|falcons|liquid|g2|vitality|s1mple|donk|m0nesy)\\b/i;\nconst candidates = [];\n\nfor (const item of $input.all()) {\n  const j = item.json;\n  const link = j.link || j.guid || '';\n  const title = String(j.title || '').trim();\n  const dateText = j.isoDate || j.pubDate || j.published || j.date || '';\n  const publishedAt = Date.parse(dateText) || now;\n  if (!link || !title || staticData.seen[link] || now - publishedAt > maxAge) continue;\n\n  let score = 0;\n  if (priorityWords.test(title)) score += 40;\n  if (/cs2|counter.?strike|dota\\s?2/i.test(title)) score += 35;\n  if (/major|the international|iem|blast|esl|final|champion|transfer|roster|ban|disqualif|patch|update/i.test(title)) score += 20;\n  score += Math.max(0, 20 - Math.floor((now - publishedAt) / 3600000));\n\n  candidates.push({\n    title,\n    link,\n    publishedAt: new Date(publishedAt).toISOString(),\n    description: String(j.contentSnippet || j.content || j.description || '')\n      .replace(/<[^>]*>/g, ' ')\n      .replace(/\\s+/g, ' ')\n      .slice(0, 1200),\n    score\n  });\n}\n\ncandidates.sort((a, b) => b.score - a.score || b.publishedAt.localeCompare(a.publishedAt));\nconst shortlist = candidates.slice(0, 25);\nif (!shortlist.length) return [{ json: { hasArticles: false, candidateCount: 0 } }];\n\nfor (const article of shortlist) staticData.seen[article.link] = now;\n\nconst list = shortlist.map((a, i) =>\n  `${i + 1}. ${a.title}\\nДата: ${a.publishedAt}\\nОписание: ${a.description}\\nСсылка: ${a.link}`\n).join('\\n\\n');\n\nconst prompt = `Ты — редактор русскоязычного Telegram-канала CyberPulse о киберспорте.\n\nИз списка выбери ОДНУ наиболее важную, свежую, обсуждаемую и интересную новость. Главный приоритет — CS2 и Dota 2. Новость из Valorant, League of Legends или другой дисциплины выбирай только если она действительно крупнее остальных. Повторение одной темы у разных изданий считай признаком обсуждаемости.\n\nНапиши готовый пост на русском языке:\n• цепляющий заголовок с 1 уместным эмодзи;\n• подробный авторский пересказ в 3–5 коротких абзацах;\n• объяснение, почему событие важно;\n• только факты из предоставленных данных, ничего не выдумывай;\n• не упоминай ИИ;\n• в конце отдельная строка «Источник: URL»;\n• общий объём до 3500 символов.\n\nКандидаты:\n${list}`;\n\nreturn [{ json: { hasArticles: true, candidateCount: shortlist.length, prompt } }];"},"id":"filter","name":"Фильтр 48 часов + защита от дублей","type":"n8n-nodes-base.code","typeVersion":2,"position":[-410,0]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"has-articles-condition","leftValue":"={{ $json.hasArticles }}","rightValue":true,"operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"id":"if","name":"Есть свежие статьи?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[-170,0]},{"parameters":{"promptType":"define","text":"={{ $json.prompt }}","options":{}},"id":"llm","name":"Gemini выбирает и пишет пост","type":"@n8n/n8n-nodes-langchain.chainLlm","typeVersion":1.7,"position":[80,-120]},{"parameters":{"options":{}},"id":"gemini","name":"Google Gemini Chat Model","type":"@n8n/n8n-nodes-langchain.lmChatGoogleGemini","typeVersion":1,"position":[80,100]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"text-check","leftValue":"={{ $json.text || $json.output || \"\" }}","rightValue":"","operator":{"type":"string","operation":"notEmpty","singleValue":true}}],"combinator":"and"},"options":{}},"id":"validate","name":"Пост сформирован?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[340,-120]},{"parameters":{"chatId":"@YOUR_CHANNEL_USERNAME","text":"={{ $json.text ||